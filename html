let row=4;for(let j=0;j<(m==='tru'?2:1);j++){let a=rows.slice(j*count,(j+1)*count);if(m==='tru'){merged(row,j===0?'HÀNG SAU':'HÀNG TRƯỚC',5,26);row++}const lines=[['TÊN GỐI',r=>r.label,2],['Xi (m)',r=>r.x,3],['Yi (m)',r=>r.y,3],['in (%)',r=>r.ins,4],['id (%)',r=>r.ids,4],['Ký hiệu gối',r=>r.type,2],['H_Vữa kê (m)',r=>r.mortar,3],['CĐ Vữa kê (m)',r=>r.z,3]];for(const [label,fn,style]of lines){out.push(`<row r="${row}" ht="29" customHeight="1">${c(0,row,label,2)}${a.map((v,i)=>c(i+1,row,fn(v),style)).join('')}</row>`);row++}row+=2}
files[`xl/worksheets/sheet${idx+1}.xml`]=`<?xml version="1.0" encoding="UTF-8"?><worksheet xmlns="${ns}"><sheetPr><pageSetUpPr fitToPage="1"/></sheetPr><dimension ref="A1:${last}${row-2}"/><sheetViews><sheetView showGridLines="0" zoomScale="90" workbookViewId="0"/></sheetViews><sheetFormatPr defaultRowHeight="24"/><cols><col min="1" max="1" width="30" customWidth="1"/><col min="2" max="${count+1}" width="13" customWidth="1"/></cols><sheetData>${out.join('')}</sheetData><mergeCells count="${merge.length}">${merge.map(r=>`<mergeCell ref="${r}"/>`).join('')}</mergeCells><printOptions horizontalCentered="1"/><pageMargins left="0.3" right="0.3" top="0.4" bottom="0.4" header="0.1" footer="0.1"/><pageSetup paperSize="9" orientation="landscape" fitToWidth="1" fitToHeight="1"/></worksheet>`;
});
files['xl/workbook.xml']=`<workbook xmlns="${ns}" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><bookViews><workbookView/></bookViews><sheets>${defs.map(s=>`<sheet name="${xmlEscape(s.name)}" sheetId="${s.id}" r:id="rId${s.id}"/>`).join('')}</sheets><definedNames>${defs.map((s,i)=>`<definedName name="_xlnm.Print_Area" localSheetId="${i}">'${xmlEscape(s.name.replace(/'/g,"''"))}'!$A$1:$${col(bookData.sheets[i].data.count/(bookData.sheets[i].kind==='tru'?2:1))}$${bookData.sheets[i].kind==='tru'?23:11}</definedName>`).join('')}</definedNames></workbook>`;
files['xl/_rels/workbook.xml.rels']=`<Relationships xmlns="${rel}">${defs.map(s=>`<Relationship Id="rId${s.id}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet${s.id}.xml"/>`).join('')}<Relationship Id="styles" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/></Relationships>`;
files['_rels/.rels']=`<Relationships xmlns="${rel}"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>`;
files['[Content_Types].xml']=`<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>${defs.map(s=>`<Override PartName="/xl/worksheets/sheet${s.id}.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>`).join('')}</Types>`;
return zipFiles(files)
}
function exportExcel(){persistBook();try{let bytes=makeExcel(book);download('Bang-cao-do-goi.xlsx',bytes,'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')}catch(e){alert('Chưa thể xuất Excel: '+e.message)}}

const qFields=['qBase','qX','qY','qZone','qDelta'];
function pointElevation(s,q){const zone=Number(q.qZone);if(['left','right','long','direction'].some(k=>s[k]===''||!Number.isFinite(Number(s[k])))||!['MT','MP','2M'].includes(s.roof))throw Error('Kiểm tra dạng mái và độ dốc của sheet.');if(qFields.some(k=>q[k]===''||!Number.isFinite(Number(q[k])))||q.qX<0||q.qY<0||![1,2,3,4].includes(zone))throw Error('Nhập đủ cao độ, Xi/Yi không âm và Zone hợp lệ.');const signs={MT:[1,-1,1,-1],MP:[-1,1,-1,1],'2M':[-1,-1,-1,-1]},ins=(zone<=2?s.left:s.right)/100*signs[s.roof][zone-1],ids=s.long/100*[1,-1,1,-1][zone-1]*s.direction,z=Number(q.qBase)+Number(q.qX)*ins+Number(q.qY)*ids+Number(q.qDelta);if(!Number.isFinite(z))throw Error('Kiểm tra thông số độ dốc của sheet.');return {z,ins,ids}}

function defaultType(s,m,j,n){let choices=types(s),code=m==='mo'?'TN':j===n/2-1||j===n/2?'DD1':'DD2';return Object.hasOwn(choices,code)?code:ensureCatalog(s)[0].code}
function materializeTypes(){const s=state[mode],n=s.count/(mode==='tru'?2:1);if(Number.isInteger(n))for(let i=0;i<s.count;i++)if(!s.types[i])s.types[i]=defaultType(s,mode,i%n,n)}
function renderCatalog(){let cat=ensureCatalog(state[mode]);const used={};try{compute(state[mode],mode).forEach(r=>used[r.type]=(used[r.type]||0)+1)}catch{}document.getElementById('bearingCatalog').innerHTML=cat.map((r,i)=>`<tr><td><input aria-label="Mã loại gối ${i+1}" value="${xmlEscape(r.code)}" onchange="editBearing(${i},'code',this.value)"></td><td><input aria-label="Chiều cao loại gối ${i+1}" type="number" step="any" min="0" value="${+(r.h*1000).toFixed(6)}" onchange="editBearing(${i},'h',this.value)"></td><td><span class="badge">${used[r.code]||0} gối</span></td><td><button class="delete" onclick="deleteBearing(${i})">Xóa</button></td></tr>`).join('')}
function editBearing(i,key,value){let s=state[mode],cat=ensureCatalog(s),r=cat[i];if(key==='code'){value=value.trim();if(!/^[A-Za-z0-9_.-]{1,24}$/.test(value)||cat.some((x,j)=>j!==i&&x.code.toLowerCase()===value.toLowerCase())){alert('Mã gối phải khác nhau, gồm 1–24 chữ/số hoặc dấu . _ -');renderCatalog();return}materializeTypes();s.types=s.types.map(t=>t===r.code?value:t);r.code=value}else{if(value===''||!Number.isFinite(Number(value))||Number(value)<0){alert('Chiều cao phải là số không âm.');renderCatalog();return}r.h=Number(value)/1000}render()}
function addBearing(){const cat=ensureCatalog(state[mode]);let i=1;while(cat.some(r=>r.code==='GOI'+i))i++;cat.push({code:'GOI'+i,h:.078});render();}
function deleteBearing(i){const s=state[mode],cat=ensureCatalog(s);if(cat.length===1)return alert('Cần giữ ít nhất một loại gối.');materializeTypes();let old=cat[i].code;if(s.types.includes(old)){let choices=cat.filter((_,j)=>i!==j).map(r=>r.code);let replacement=prompt('Loại '+old+' đang dùng. Nhập mã thay thế: '+choices.join(', '),choices[0]);if(replacement===null)return;if(!choices.includes(replacement))return alert('Mã thay thế không hợp lệ.');s.types=s.types.map(t=>t===old?replacement:t)}cat.splice(i,1);render()}
function initPoints(){book.sheets.forEach((sh,i)=>{if(!sh.id)sh.id='sheet-'+Date.now()+'-'+i+'-'+Math.random().toString(36).slice(2,7)});if(!book.points){book.points={source:book.sheets[0].id,rows:[]};book.sheets.forEach(sh=>{if(sh.data.quick){let q=sh.data.quick;book.points.rows.push({name:'Điểm cũ · '+sh.data.name,...q})}})}if(!Array.isArray(book.points.rows))book.points.rows=[];book.points.rows.forEach(p=>{if(!Object.hasOwn(p,'source'))p.source=book.points.source||book.sheets[book.active].id})}
function appendPointTab(t){let b=document.createElement('button');b.textContent='Cao độ điểm bất kỳ';b.className=pointsView?'active':'';b.setAttribute('role','tab');b.setAttribute('aria-selected',String(pointsView));b.onclick=openPoints;t.appendChild(b)}
function toggleView(){document.getElementById('bearingView').hidden=pointsView;document.getElementById('pointsView').hidden=!pointsView;for(const id of ['duplicateSheetButton','deleteSheetButton','printButton'])document.getElementById(id).hidden=pointsView}
function openPoints(){persistBook();initPoints();pointsView=true;toggleView();paintTabs();renderPoints();persistBook()}
function sourcePoint(p){return book.sheets.find(sh=>sh.id===(p?p.source:book.sheets[book.active].id))}
function addPoint(){initPoints();const sh=sourcePoint();book.points.rows.push({source:sh?sh.id:'',name:'P'+(book.points.rows.length+1),qBase:sh?sh.data.base:0,qX:0,qY:0,qZone:1,qDelta:0});renderPoints();persistBook()}
function updatePoint(i,k,v){book.points.rows[i][k]=v;renderPoints();persistBook()}
function removePoint(i){book.points.rows.splice(i,1);renderPoints();persistBook()}
function renderPoints(){initPoints();document.getElementById('pointRows').innerHTML=book.points.rows.map((p,i)=>{const sh=sourcePoint(p);let z='—',error='';try{if(!sh)throw Error('Chọn mố/trụ tham chiếu cho điểm này');z=pointElevation(sh.data,p).z.toFixed(6)}catch(e){error=e.message}let input=(k,type='number')=>`<input aria-label="${k} điểm ${i+1}" type="${type}" ${type==='number'?'step="any"':''} value="${xmlEscape(p[k]??'')}" onchange="updatePoint(${i},'${k}',this.value)">`;let source=`<select aria-label="Mố trụ lấy dạng mái điểm ${i+1}" onchange="updatePoint(${i},'source',this.value)"><option value="">Chọn mố / trụ</option>${book.sheets.map(sh=>`<option value="${xmlEscape(sh.id)}" ${sh.id===p.source?'selected':''}>${xmlEscape(sh.data.name||'Mố / trụ')} · ${xmlEscape(sh.data.roof)}</option>`).join('')}</select>`;let info=sh?`Ngang ${sh.data.left}% / ${sh.data.right}% · Dọc ${sh.data.long}% · ${Number(sh.data.direction)===1?'↑':'↓'}`:'';return `<tr><td>${input('name','text')}</td><td class="point-reference">${source}<small>${xmlEscape(info)}</small></td><td>${input('qBase')}</td><td>${input('qX')}</td><td>${input('qY')}</td><td><select aria-label="Zone điểm ${i+1}" onchange="updatePoint(${i},'qZone',this.value)">${[1,2,3,4].map(n=>`<option value="${n}" ${Number(p.qZone)===n?'selected':''}>Zone ${n}</option>`).join('')}</select></td><td>${input('qDelta')}</td><td class="${error?'point-error':''}">${xmlEscape(error||z)}</td><td><button onclick="book.points.rows.splice(${i}+1,0,structuredClone(book.points.rows[${i}]));renderPoints();persistBook()">Nhân bản</button> <button class="delete" onclick="removePoint(${i})">Xóa</button></td></tr>`}).join('')||'<tr><td colspan="9" class="muted">Chưa có điểm. Nhấn “+ Thêm điểm” để bắt đầu.</td></tr>'}

initPoints();zoneFigures();selectSheet(book.active);
</script></html>
